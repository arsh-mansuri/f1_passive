{
  "name": "pitwall",
  "version": "1.0.0",
  "private": true,
  "description": "PitWall — an ambient F1 race replayer. Real positions, real overtakes, no video.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "fetch:circuits": "tsx scripts/fetch-circuits.ts",
    "fetch:openf1": "tsx scripts/fetch-openf1.ts",
    "make:races": "tsx scripts/make-samples.ts",
    "make:samples": "tsx scripts/make-samples.ts",
    "build:data": "tsx scripts/build-data.ts",
    "gen:commentary": "tsx scripts/gen-commentary.ts",
    "ingest": "tsx scripts/build-data.ts && tsx scripts/gen-commentary.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "framer-motion": "11.18.2",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "^5.7.2"
  }
}
